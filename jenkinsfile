pipeline {
    agent any

    stages {

        stage('scm checkout') {
            steps {
                git branch: "main",
                    url: "https://github.com/benazeersitharashaik-ops/sample1-public.git"
            }
        }

        stage("archiving artifacts") {
            steps {
                archiveArtifacts "**/*.*"
            }
        }

        stage("Deployment") {
            steps {
                sshPublisher(
                    publishers: [
                        sshPublisherDesc(
                            configName: 'docker',
                            transfers: [
                                sshTransfer(
                                    excludes: '',
                                    execCommand: '',
                                    execTimeout: 120000,
                                    flatten: true,
                                    makeEmptyDirs: false,
                                    noDefaultExcludes: false,
                                    patternSeparator: '[, ]+',
                                    remoteDirectory: 'www/html',
                                    remoteDirectorySDF: false,
                                    removePrefix: '',
                                    sourceFiles: '**/*.*'
                                )
                            ],
                            usePromotionTimestamp: false,
                            useWorkspaceInPromotion: false,
                            verbose: true
                        )
                    ]
                )
            }
        }
    }
}
